# ==============================================================================
# GOBILLING / UNMS — Dokploy Production Environment Template
# ==============================================================================
# Paste these variables into the Dokploy Dashboard under Service -> Environment:

APP_NAME="GOBILLING"
APP_ENV=production
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://buroq.gobilling.id
APP_DOMAIN=buroq.gobilling.id
DOKPLOY_ROUTER_NAME=gobilling
APP_PORT=80
APP_IMAGE=

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12


LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Database (MySQL 8.4)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gobilling
DB_USERNAME=gobilling
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret_root

# ------------------------------------------------------------------------------
# Session, Cache & Queue (Redis & Laravel Horizon)
# ------------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=gobilling_cache:

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
HORIZON_PREFIX=gobilling_horizon:

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# Container Boot Operations
# ------------------------------------------------------------------------------
# Set to true in Dokploy to run migrations automatically on container boot
RUN_MIGRATIONS=true
# Set to true in production to warm config, route, and view caches on boot
CACHE_ON_STARTUP=true


# ------------------------------------------------------------------------------
# Mail (Mailpit for local testing, SMTP/SES/Postmark for prod)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@gobilling.id"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# WhatsApp Gateway (WAHA / Wablas)
# ------------------------------------------------------------------------------
WAHA_HOST=http://waha:3000
WAHA_SESSION=gobilling
WAHA_API_KEY=
WAHA_USERNAME=admin
WAHA_PASSWORD=
WAHA_NUMBER=

WABLAS_NUMBER=
WABLAS_HOST=https://tegal.wablas.com
WABLAS_TOKEN=
WABLAS_SECRET=

# ------------------------------------------------------------------------------
# Payment Gateways (Xendit & iPaymu)
# ------------------------------------------------------------------------------
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_ENV=development

IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_ENV=sandbox

# ------------------------------------------------------------------------------
# Frontend & Monitoring
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

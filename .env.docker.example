# ==============================================================================
# GOBILLING / UNMS - Docker Environment Configuration
# ==============================================================================

APP_NAME=GOBILLING
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
VITE_PORT=5173

# Dokploy & Production Ingress (Traefik Domain)
APP_DOMAIN=billing.example.com
DOKPLOY_ROUTER_NAME=gobilling
RUN_MIGRATIONS=true

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (Docker MySQL 8.4)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gobilling
DB_USERNAME=gobilling
DB_PASSWORD=secret
FORWARD_DB_PORT=3306

# Redis (Queue, Cache, Sessions, Horizon)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Mail (Local Mailpit Catcher)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@gobilling.id"
MAIL_FROM_NAME="${APP_NAME}"
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# Horizon Configuration
HORIZON_PREFIX=gobilling_horizon:

# WhatsApp HTTP API (WAHA)
WAHA_HOST=http://waha:3000
WAHA_SESSION=gobilling
WAHA_API_KEY=137ae04e09ee4c668430c660db0741f9
WAHA_USERNAME=admin
WAHA_PASSWORD=secret
FORWARD_WAHA_PORT=3000

# Payment Gateways (Optional / Sandbox)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_ENV=development

IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_ENV=sandbox

# Sentry (Optional error monitoring)
SENTRY_LARAVEL_DSN=

# Permissions Mapping (Dev only: match host UID/GID)
WWWUSER=1000
WWWGROUP=1000

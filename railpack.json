{
    "$schema": "https://schema.railpack.com",
    "provider": "php",
    "steps": {
        "supercronic": {
            "inputs": [
                {
                    "image": "alpine:3.22"
                }
            ],
            "commands": [
                {
                    "cmd": "wget -qO /usr/local/bin/supercronic https://github.com/aptible/supercronic/releases/download/v0.2.49/supercronic-linux-amd64",
                    "customName": "Download supercronic"
                },
                {
                    "cmd": "echo 'e63c11a9726b775a6a11801e81af4f3fb926aa68  /usr/local/bin/supercronic' | sha1sum -c -",
                    "customName": "Verify supercronic checksum"
                },
                "chmod +x /usr/local/bin/supercronic"
            ]
        }
    },
    "deploy": {
        "aptPackages": [
            "supervisor"
        ],
        "inputs": [
            "...",
            {
                "step": "supercronic",
                "include": [
                    "/usr/local/bin/supercronic"
                ]
            }
        ],
        "variables": {
            "APP_ENV": "production",
            "APP_DEBUG": "false",
            "LOG_CHANNEL": "stderr"
        },
        "startCommand": "bash /app/deploy/start.sh"
    }
}
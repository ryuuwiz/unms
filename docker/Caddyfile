{
    auto_https off

    frankenphp
}

:80 {
    root * /var/www/html/public
    encode zstd gzip

    request_body {
        max_size 64MB
    }

    # Static file caching with immutable headers for Vite assets
    @static {
        file
        path *.ico *.css *.js *.gif *.webp *.avif *.jpg *.jpeg *.png *.svg *.woff *.woff2 *.ttf *.eot
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Avoid aggressive caching for Livewire dynamic endpoints
    @livewire {
        path /livewire/*
    }
    header @livewire Cache-Control "no-cache, no-store, must-revalidate"

    # Execute PHP via FrankenPHP
    php_server {
        try_files {path} index.php
    }
}
